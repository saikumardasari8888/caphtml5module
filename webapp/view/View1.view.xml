<mvc:View controllerName="ns.html5module.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true" 
    xmlns="sap.m">
	<Shell id="shell">
		<App id="app">
			<pages>
				<Page id="page" title="{i18n>title}">
<content>
            <Table id="salesTable" items="{/SalesData}">

                <columns>
                    <Column>
                        <Text text="Sale ID"/>
                    </Column>

                    <Column>
                        <Text text="Sale Date"/>
                    </Column>

                    <Column>
                        <Text text="Product"/>
                    </Column>

                    <Column>
                        <Text text="Region"/>
                    </Column>

                    <Column hAlign="End">
                        <Text text="Sales Amount"/>
                    </Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{SaleID}"/>
                            <Text text="{SaleDate}"/>
                            <Text text="{Product}"/>
                            <Text text="{Region}"/>
                            <ObjectNumber number="{SalesAmount}"/>
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </content>				</Page>
			</pages>
		</App>
	</Shell>
</mvc:View>
